+#endif
+
+#include <string.h>
+#include <unistd.h>
+
+#include "wimlib/assert.h"
+#include "wimlib/blob_table.h"
+#include "wimlib/error.h"
+#include "wimlib/prefetch.h"
+#include "wimlib/threads.h"
+#include "wimlib/util.h"
+#include "wimlib/wim.h"
+
+#define PREFETCH_MAX_BLOB_SIZE	((u64)32 * 1024 * 1024)
+#define PREFETCH_DELIVERY_CHUNK	((size_t)1024 * 1024)
+#define PREFETCH_WORKER_RESERVE	((u64)2 * 1024 * 1024)
+
+enum prefetch_worker_state {
+	PREFETCH_IDLE,
+	PREFETCH_ASSIGNED,
+	PREFETCH_COMPLETE,
+	PREFETCH_TERMINATING,
+};
+
+struct prefetch_buffer_ctx {
+	u8 *buffer;
+	size_t capacity;
+	size_t offset;
+};
+
+struct prefetch_worker {
+	struct thread thread;
+	struct mutex lock;
+	struct condvar state_changed;
+	enum prefetch_worker_state state;
+	bool thread_started;
+	bool lock_initialized;
+	bool condvar_initialized;
+	bool recover_data;
+	struct blob_descriptor *blob;
+	WIMStruct *fd_wim;
+	struct filedes in_fd;
+	bool in_fd_open;
+	u8 *buffer;
+	size_t buffer_capacity;
+	int result;
+};
+
+static int
+buffer_blob_chunk(const struct blob_descriptor *blob, u64 offset,
+		  const void *chunk, size_t size, void *_ctx)
+{
+	struct prefetch_buffer_ctx *ctx = _ctx;
+
+	(void)blob;
+	if (offset != ctx->offset || size > ctx->capacity - ctx->offset)
+		return WIMLIB_ERR_INVALID_PARAM;
+	memcpy(ctx->buffer + ctx->offset, chunk, size);
+	ctx->offset += size;
+	return 0;
+}
+
+static int
+prefetch_blob(struct prefetch_worker *worker)
+{
+	struct prefetch_buffer_ctx buffer_ctx;
+	struct read_blob_callbacks cbs = {
+		.continue_blob = buffer_blob_chunk,
+		.ctx = &buffer_ctx,
+	};
+	size_t size = worker->blob->size;
+	WIMStruct *wim = worker->blob->rdesc->wim;
+
+	if (worker->fd_wim != wim) {
+		if (worker->in_fd_open) {
+			filedes_close(&worker->in_fd);
+			worker->in_fd_open = false;
+		}
+		int ret = open_parallel_read_filedes(wim->filename,
+						    &worker->in_fd);
+		if (ret)
+			return ret;
+		worker->in_fd_open = true;
+		worker->fd_wim = wim;
+	}
+
+	if (worker->buffer_capacity < size) {
+		void *new_buffer = REALLOC(worker->buffer, size);
+
+		if (!new_buffer)
+			return WIMLIB_ERR_NOMEM;
+		worker->buffer = new_buffer;
+		worker->buffer_capacity = size;
+	}
+
+	buffer_ctx = (struct prefetch_buffer_ctx) {
+		.buffer = worker->buffer,
+		.capacity = size,
+	};
+	return read_blob_with_sha1_isolated_from(worker->blob, &cbs,
+						 worker->recover_data,
+						 &worker->in_fd);
+}
+
+static void *
+prefetch_worker_proc(void *_worker)
+{
+	struct prefetch_worker *worker = _worker;
+
+	mutex_lock(&worker->lock);
+	for (;;) {
+		while (worker->state == PREFETCH_IDLE)
+			condvar_wait(&worker->state_changed, &worker->lock);
+		if (worker->state == PREFETCH_TERMINATING)
+			break;
+
+		wimlib_assert(worker->state == PREFETCH_ASSIGNED);
+		mutex_unlock(&worker->lock);
+		worker->result = prefetch_blob(worker);
+		mutex_lock(&worker->lock);
+
+		if (worker->state == PREFETCH_TERMINATING)
+			break;
+		worker->state = PREFETCH_COMPLETE;
+		condvar_broadcast(&worker->state_changed);
+		while (worker->state == PREFETCH_COMPLETE)
+			condvar_wait(&worker->state_changed, &worker->lock);
+		if (worker->state == PREFETCH_TERMINATING)
+			break;
+	}
+	mutex_unlock(&worker->lock);
+	return NULL;
+}
+
+static int
+assign_prefetch(struct prefetch_worker *worker,
+		struct blob_descriptor *blob)
+{
+	mutex_lock(&worker->lock);
+	if (worker->state != PREFETCH_IDLE) {
+		mutex_unlock(&worker->lock);
+		return WIMLIB_ERR_INVALID_PARAM;
+	}
+	worker->blob = blob;
+	worker->state = PREFETCH_ASSIGNED;
+	condvar_broadcast(&worker->state_changed);
+	mutex_unlock(&worker->lock);
+	return 0;
+}
+
+static int
+deliver_prefetched_blob(struct prefetch_worker *worker,
+			const struct read_blob_callbacks *cbs)
+{
+	struct blob_descriptor *blob;
+	int ret;
+
+	mutex_lock(&worker->lock);
+	while (worker->state == PREFETCH_ASSIGNED)
+		condvar_wait(&worker->state_changed, &worker->lock);
+	wimlib_assert(worker->state == PREFETCH_COMPLETE);
+
+	ret = worker->result;
+	blob = worker->blob;
+	mutex_unlock(&worker->lock);
+
+	if (!ret) {
+		ret = call_begin_blob(blob, cbs);
+		if (ret == BEGIN_BLOB_STATUS_SKIP_BLOB) {
+			ret = 0;
+		} else if (!ret) {
+			for (size_t offset = 0; offset < blob->size; ) {
+				size_t size = min(PREFETCH_DELIVERY_CHUNK,
+						  (size_t)blob->size - offset);
+
+				ret = call_continue_blob(blob, offset,
+							 worker->buffer + offset,
+							 size, cbs);
+				if (ret)
+					break;
+				offset += size;
+			}
+			ret = call_end_blob(blob, ret, cbs);
+		}
+	}
+
+	mutex_lock(&worker->lock);
+	worker->state = PREFETCH_IDLE;
+	condvar_broadcast(&worker->state_changed);
+	mutex_unlock(&worker->lock);
+	return ret;
+}
+
+static void
+destroy_prefetch_workers(struct prefetch_worker *workers,
+			 unsigned num_workers)
+{
+	if (!workers)
+		return;
+
+	for (unsigned i = 0; i < num_workers; i++) {
+		if (!workers[i].thread_started)
+			continue;
+		mutex_lock(&workers[i].lock);
+		workers[i].state = PREFETCH_TERMINATING;
+		condvar_broadcast(&workers[i].state_changed);
+		mutex_unlock(&workers[i].lock);
+	}
+	for (unsigned i = 0; i < num_workers; i++) {
+		if (workers[i].thread_started)
+			thread_join(&workers[i].thread);
+		if (workers[i].in_fd_open)
+			filedes_close(&workers[i].in_fd);
+		FREE(workers[i].buffer);
+		if (workers[i].condvar_initialized)
+			condvar_destroy(&workers[i].state_changed);
+		if (workers[i].lock_initialized)
+			mutex_destroy(&workers[i].lock);
+	}
+	FREE(workers);
+}
+
+static bool
+blob_list_supports_prefetch(struct blob_descriptor **blobs, size_t num_blobs,
+			    WIMStruct **wim_ret)
+{
+	WIMStruct *wim = NULL;
+
+	for (size_t i = 0; i < num_blobs; i++) {
+		struct blob_descriptor *blob = blobs[i];
+
+		if (blob->blob_location != BLOB_IN_WIM ||
+		    blob->unhashed ||
+		    blob->size != blob->rdesc->uncompressed_size ||
+		    blob->rdesc->is_pipable ||
+		    (blob->rdesc->flags & WIM_RESHDR_FLAG_SOLID))
+			return false;
+		if (!wim)
+			wim = blob->rdesc->wim;
+	}
+	*wim_ret = wim;
+	return wim != NULL;
+}
+
+static unsigned
+get_prefetch_worker_count(const WIMStruct *wim, size_t num_blobs,
+			  u64 *max_blob_size_ret)
+{
+	u64 max_memory = wim->decompression_max_memory;
+	u64 worker_reserve;
+	unsigned num_workers = wim->decompression_num_threads;
+	u64 max_blob_size;
+
+	if (num_workers == 0)
+		num_workers = get_available_cpus();
+	if ((size_t)num_workers > num_blobs)
+		num_workers = num_blobs;
+	if (max_memory == 0)
+		max_memory = min(get_available_memory() / 4,
+				 (u64)2 * 1024 * 1024 * 1024);
+	worker_reserve = max(PREFETCH_WORKER_RESERVE,
+			     (u64)2 * wim->chunk_size);
+
+	while (num_workers > 1 &&
+	       max_memory / num_workers <= worker_reserve)
+		num_workers--;
+	if (num_workers < 2)
+		return num_workers;
+
+	max_blob_size = max_memory / num_workers - worker_reserve;
+	*max_blob_size_ret = min(max_blob_size, PREFETCH_MAX_BLOB_SIZE);
+	return num_workers;
+}
+
+static int
+prefetch_blob_run(struct prefetch_worker *workers, unsigned num_workers,
+		  struct blob_descriptor **blobs, size_t num_blobs,
+		  const struct read_blob_callbacks *cbs)
+{
+	unsigned active_workers = min((size_t)num_workers, num_blobs);
+	size_t next_blob = 0;
+	int ret;
+
+	for (unsigned i = 0; i < active_workers; i++) {
+		ret = assign_prefetch(&workers[i], blobs[next_blob++]);
+		if (ret)
+			return ret;
+	}
+
+	for (size_t completed = 0; completed < num_blobs; completed++) {
+		struct prefetch_worker *worker =
+			&workers[completed % active_workers];
+
+		ret = deliver_prefetched_blob(worker, cbs);
+		if (ret)
+			return ret;
+		if (next_blob < num_blobs) {
+			ret = assign_prefetch(worker, blobs[next_blob++]);
+			if (ret)
+				return ret;
+		}
+	}
+	return 0;
+}
+
+int
+read_blob_list_with_prefetch(struct list_head *blob_list,
+			     size_t list_head_offset,
+			     const struct read_blob_callbacks *cbs,
+			     int flags)
+{
+	struct prefetch_worker *workers = NULL;
+	struct blob_descriptor **blobs = NULL;
+	struct list_head *cur;
+	WIMStruct *wim;
+	size_t num_blobs = 0;
+	unsigned num_workers;
+	u64 max_blob_size = 0;
+	int ret = WIMLIB_ERR_NOMEM;
+
+	if (!(flags & PARALLEL_BLOB_PREFETCH) ||
+	    !(flags & VERIFY_BLOB_HASHES) ||
+	    (flags & COMPUTE_MISSING_BLOB_HASHES))
+		return -1;
+
+	for (cur = blob_list->next; cur != blob_list; cur = cur->next)
+		num_blobs++;
+	if (num_blobs < 2)
+		return -1;
+
+	blobs = MALLOC(num_blobs * sizeof(blobs[0]));
+	if (!blobs)
+		goto out;
+	size_t i = 0;
+	for (cur = blob_list->next; cur != blob_list; cur = cur->next)
+		blobs[i++] =
+			(struct blob_descriptor *)((u8 *)cur - list_head_offset);
+
+	if (!blob_list_supports_prefetch(blobs, num_blobs, &wim) ||
+	    wim->decompression_num_threads == 1) {
+		ret = -1;
+		goto out;
+	}
+
+	num_workers = get_prefetch_worker_count(wim, num_blobs,
+						&max_blob_size);
+	if (num_workers < 2 || max_blob_size == 0) {
+		ret = -1;
+		goto out;
+	}
+
+	workers = CALLOC(num_workers, sizeof(workers[0]));
+	if (!workers)
+		goto out;
+	for (unsigned i = 0; i < num_workers; i++) {
+		struct prefetch_worker *worker = &workers[i];
+
+		if (!mutex_init(&worker->lock))
+			goto out;
+		worker->lock_initialized = true;
+		if (!condvar_init(&worker->state_changed))
+			goto out;
+		worker->condvar_initialized = true;
+		worker->recover_data = flags & RECOVER_DATA;
+		if (!thread_create(&worker->thread,
+				   prefetch_worker_proc, worker))
+			goto out;
+		worker->thread_started = true;
+	}
+
+	ret = 0;
+	for (size_t run_start = 0; run_start < num_blobs; ) {
+		size_t run_end = run_start;
+
+		while (run_end < num_blobs &&
+		       blobs[run_end]->size <= max_blob_size)
+			run_end++;
+		if (run_end - run_start >= 2) {
+			ret = prefetch_blob_run(workers, num_workers,
+					       &blobs[run_start],
+					       run_end - run_start, cbs);
+			if (ret)
+				goto out;
+			run_start = run_end;
+		} else {
+			ret = read_blob_with_sha1(blobs[run_start], cbs,
+						 flags & RECOVER_DATA);
+			if (ret != 0 && ret != BEGIN_BLOB_STATUS_SKIP_BLOB)
+				goto out;
+			ret = 0;
+			run_start++;
+		}
+	}
+
+out:
+	destroy_prefetch_workers(workers, workers ? num_workers : 0);
+	FREE(blobs);
+	return ret;
+}
