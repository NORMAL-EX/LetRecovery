+/*
+ * GetSystemInfo() only reports the current processor group.  Dynamically use
+ * the group-aware Windows 7 APIs when available so the binary keeps its older
+ * Windows load-time compatibility.
+ */
 unsigned
 get_available_cpus(void)
 {
+	HMODULE kernel32 = GetModuleHandleW(L"kernel32.dll");
+	get_active_processor_group_count_t get_group_count;
+	get_active_processor_count_t get_processor_count;
+	get_process_group_affinity_t get_process_groups;
+	DWORD_PTR process_mask;
+	DWORD_PTR system_mask;
 	SYSTEM_INFO sysinfo;
+
+	get_group_count = kernel32 ?
+		(get_active_processor_group_count_t)
+			GetProcAddress(kernel32, "GetActiveProcessorGroupCount") :
+		NULL;
+	get_processor_count = kernel32 ?
+		(get_active_processor_count_t)
+			GetProcAddress(kernel32, "GetActiveProcessorCount") :
+		NULL;
+	get_process_groups = kernel32 ?
+		(get_process_group_affinity_t)
+			GetProcAddress(kernel32, "GetProcessGroupAffinity") :
+		NULL;
+
+	if (get_group_count && get_processor_count) {
+		WORD num_groups = get_group_count();
+
+		if (num_groups == 1 &&
+		    GetProcessAffinityMask(GetCurrentProcess(), &process_mask,
+					   &system_mask)) {
+			unsigned count = count_set_affinity_bits(process_mask);
+
+			if (count)
+				return count;
+		}
+
+		if (num_groups > 1) {
+			unsigned total = 0;
+
+			if (get_process_groups) {
+				USHORT process_group_count = num_groups;
+				USHORT *groups =
+					MALLOC(process_group_count * sizeof(groups[0]));
+
+				if (groups &&
+				    get_process_groups(GetCurrentProcess(),
+						       &process_group_count,
+						       groups)) {
+					for (USHORT i = 0; i < process_group_count; i++) {
+						DWORD count = get_processor_count(groups[i]);
+
+						if (count > UINT_MAX - total) {
+							total = UINT_MAX;
+							break;
+						}
+						total += count;
+					}
+				}
+				FREE(groups);
+			}
+			if (!total)
+				total = get_processor_count(ALL_PROCESSOR_GROUPS);
+			if (total)
+				return total;
+		}
+	}
+
+	if (GetProcessAffinityMask(GetCurrentProcess(), &process_mask,
+				   &system_mask)) {
+		unsigned count = count_set_affinity_bits(process_mask);
+
+		if (count)
+			return count;
+	}
+
 	GetSystemInfo(&sysinfo);
-	return sysinfo.dwNumberOfProcessors;
+	return max((unsigned)sysinfo.dwNumberOfProcessors, 1);
 }
 
