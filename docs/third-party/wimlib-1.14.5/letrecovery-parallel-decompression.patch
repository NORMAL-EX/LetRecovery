+out:
+	if (condvar_initialized)
+		condvar_destroy(&ctx.state_changed);
+	if (lock_initialized)
+		mutex_destroy(&ctx.lock);
+	FREE(workers);
+	FREE(ctx.results);
+	FREE(ctx.completed_blobs);
+	FREE(ctx.blobs);
+	return ret;
+}
