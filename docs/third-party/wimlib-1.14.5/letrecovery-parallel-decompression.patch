+/*
+ * Open an independent read handle for a parallel worker.  On Windows wimlib's
+ * pread() replacement temporarily manipulates the handle's file position, so
+ * sharing the WIM's primary descriptor across workers is neither safe nor
+ * fully concurrent.
+ */
+int
+open_parallel_read_filedes(const tchar *filename, struct filedes *fd)
+{
+	int raw_fd;
+
+	if (!filename)
+		return WIMLIB_ERR_INVALID_PARAM;
+	raw_fd = topen(filename, O_RDONLY | O_BINARY);
+	if (raw_fd < 0) {
+		ERROR_WITH_ERRNO("Can't open \"%"TS"\" for parallel reading",
+				 filename);
+		return WIMLIB_ERR_OPEN;
+	}
+	filedes_init(fd, raw_fd);
+	return 0;
+}
+
 /*
  * Wrapper around read() that checks for errors and keeps retrying until all
  * requested bytes have been read or until end-of file has occurred.
@@ -141,6 +165,34 @@ is_pipe:
 	return pipe_read(fd, buf, count, offset);
 }
 
+int
+full_pread_unshared(struct filedes *fd, void *buf, size_t count, off_t offset)
+{
+	if (fd->is_pipe)
+		return full_pread(fd, buf, count, offset);
+
+	while (count) {
+#ifdef _WIN32
+		ssize_t ret = win32_pread_unshared(fd->fd, buf, count, offset);
+#else
+		ssize_t ret = pread(fd->fd, buf, count, offset);
+#endif
+		if (unlikely(ret <= 0)) {
+			if (ret == 0) {
+				errno = EINVAL;
+				return WIMLIB_ERR_UNEXPECTED_END_OF_FILE;
+			}
+			if (errno == EINTR)
+				continue;
+			return WIMLIB_ERR_READ;
+		}
+		buf += ret;
+		count -= ret;
+		offset += ret;
+	}
+	return 0;
+}
+
 /*
  * Wrapper around write() that checks for errors and keeps retrying until all
  * requested bytes have been written.
