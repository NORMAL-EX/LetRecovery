+ssize_t
+win32_pread_unshared(int fd, void *buf, size_t count, off_t offset)
+{
+	HANDLE h;
+	DWORD result = 0;
+	OVERLAPPED overlapped = { 0 };
+	DWORD err;
+
+	h = (HANDLE)_get_osfhandle(fd);
+	if (h == INVALID_HANDLE_VALUE)
+		return -1;
+	if (GetFileType(h) == FILE_TYPE_PIPE) {
+		errno = ESPIPE;
+		return -1;
+	}
+	overlapped.Offset = offset;
+	overlapped.OffsetHigh = offset >> 32;
+	count = min(count, MAX_IO_AMOUNT);
+	if (!ReadFile(h, buf, count, &result, &overlapped)) {
+		err = GetLastError();
+		win32_error(err, L"Failed to read %zu bytes at offset %"PRIu64,
+			    count, offset);
+		set_errno_from_win32_error(err);
+		return -1;
+	}
+	return result;
+}
