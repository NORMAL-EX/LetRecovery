+#ifndef _WIMLIB_DECOMPRESS_PARALLEL_H
+#define _WIMLIB_DECOMPRESS_PARALLEL_H
+
+#include "wimlib/types.h"
+
+/*
+ * A seekable compressed-resource chunk that can be read independently with
+ * pread().  Jobs must be supplied in their original uncompressed order.
+ */
+struct parallel_decompression_job {
+	u64 file_offset;
+	u64 uncompressed_offset;
+	u32 compressed_size;
+	u32 uncompressed_size;
+};
+
+typedef int (*parallel_decompression_consumer_t)(
+			const void *chunk, u32 size, u64 uncompressed_offset,
+			void *ctx);
+
+/*
+ * Read and decompress @jobs with a bounded worker set, then invoke @consumer
+ * on the caller thread in the original job order.
+ *
+ * Returns -1 when parallel execution is not useful, so the caller can use its
+ * existing serial path.  Otherwise returns a wimlib status code.
+ */
+int
+decompress_jobs_parallel(const tchar *filename,
+			 const struct parallel_decompression_job *jobs,
+			 size_t num_jobs, int ctype, u32 chunk_size,
+			 unsigned num_threads, u64 max_memory,
+			 bool recover_data,
+			 parallel_decompression_consumer_t consumer,
+			 void *consumer_ctx);
+
+#endif /* _WIMLIB_DECOMPRESS_PARALLEL_H */
