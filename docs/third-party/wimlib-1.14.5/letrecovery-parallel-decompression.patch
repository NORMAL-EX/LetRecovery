diff --git a/src/decompress_parallel.c b/src/decompress_parallel.c
new file mode 100644
index 00000000..1fd3e4e5
--- /dev/null
+++ b/src/decompress_parallel.c
@@ -0,0 +1,342 @@
+/*
+ * decompress_parallel.c
+ *
+ * Bounded, ordered parallel decompression for seekable WIM resources.
+ */
+
+/*
+ * Copyright (C) 2026 LetRecovery contributors
+ *
+ * This file is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU Lesser General Public License as published by the Free
+ * Software Foundation; either version 3 of the License, or (at your option) any
+ * later version.
+ */
+
+#ifdef HAVE_CONFIG_H
+#  include "config.h"
+#endif
+
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "wimlib/assert.h"
+#include "wimlib/decompress_parallel.h"
+#include "wimlib/error.h"
+#include "wimlib/file_io.h"
+#include "wimlib/threads.h"
+#include "wimlib/util.h"
+#include "wimlib.h"
+
+enum worker_state {
+	WORKER_IDLE,
+	WORKER_ASSIGNED,
+	WORKER_COMPLETE,
+	WORKER_TERMINATING,
+};
+
+struct decompressor_worker {
+	struct thread thread;
+	struct mutex lock;
+	struct condvar state_changed;
+	enum worker_state state;
+	bool thread_started;
+	bool lock_initialized;
+	bool condvar_initialized;
+	bool recover_data;
+
+	struct filedes in_fd;
+	bool in_fd_open;
+	struct wimlib_decompressor *decompressor;
+	struct parallel_decompression_job job;
+	void *compressed_buf;
+	u8 *uncompressed_buf;
+	int result;
+};
+
+static int
+worker_process_job(struct decompressor_worker *worker)
+{
+	const struct parallel_decompression_job *job = &worker->job;
+	void *read_buf;
+	int ret;
+
+	if (job->compressed_size == job->uncompressed_size)
+		read_buf = worker->uncompressed_buf;
+	else
+		read_buf = worker->compressed_buf;
+
+	ret = full_pread(&worker->in_fd, read_buf, job->compressed_size,
+			 job->file_offset);
+	if (ret)
+		return ret;
+
+	if (read_buf == worker->uncompressed_buf)
+		return 0;
+
+	ret = wimlib_decompress(worker->compressed_buf, job->compressed_size,
+				worker->uncompressed_buf,
+				job->uncompressed_size,
+				worker->decompressor);
+	if (likely(ret == 0))
+		return 0;
+
+	if (!worker->recover_data)
+		return WIMLIB_ERR_DECOMPRESSION;
+
+	/*
+	 * Match resource.c's recovery behavior: make the unread portion
+	 * deterministic, then retry so a codec that can recover a prefix gets a
+	 * chance to do so.
+	 */
+	memset(worker->uncompressed_buf, 0, job->uncompressed_size);
+	(void)wimlib_decompress(worker->compressed_buf, job->compressed_size,
+			       worker->uncompressed_buf,
+			       job->uncompressed_size,
+			       worker->decompressor);
+	return 0;
+}
+
+static void *
+decompressor_worker_proc(void *arg)
+{
+	struct decompressor_worker *worker = arg;
+
+	mutex_lock(&worker->lock);
+	for (;;) {
+		while (worker->state == WORKER_IDLE)
+			condvar_wait(&worker->state_changed, &worker->lock);
+
+		if (worker->state == WORKER_TERMINATING)
+			break;
+
+		wimlib_assert(worker->state == WORKER_ASSIGNED);
+		mutex_unlock(&worker->lock);
+		worker->result = worker_process_job(worker);
+		mutex_lock(&worker->lock);
+
+		if (worker->state == WORKER_TERMINATING)
+			break;
+		worker->state = WORKER_COMPLETE;
+		condvar_broadcast(&worker->state_changed);
+
+		while (worker->state == WORKER_COMPLETE)
+			condvar_wait(&worker->state_changed, &worker->lock);
+		if (worker->state == WORKER_TERMINATING)
+			break;
+	}
+	mutex_unlock(&worker->lock);
+	return NULL;
+}
+
+static void
+terminate_worker(struct decompressor_worker *worker)
+{
+	mutex_lock(&worker->lock);
+	worker->state = WORKER_TERMINATING;
+	condvar_broadcast(&worker->state_changed);
+	mutex_unlock(&worker->lock);
+}
+
+static int
+assign_job(struct decompressor_worker *worker,
+	   const struct parallel_decompression_job *job)
+{
+	mutex_lock(&worker->lock);
+	if (unlikely(worker->state != WORKER_IDLE)) {
+		mutex_unlock(&worker->lock);
+		return WIMLIB_ERR_INVALID_PARAM;
+	}
+	worker->job = *job;
+	worker->state = WORKER_ASSIGNED;
+	condvar_broadcast(&worker->state_changed);
+	mutex_unlock(&worker->lock);
+	return 0;
+}
+
+static int
+consume_worker_result(struct decompressor_worker *worker,
+		      parallel_decompression_consumer_t consumer,
+		      void *consumer_ctx)
+{
+	int ret;
+
+	mutex_lock(&worker->lock);
+	while (worker->state == WORKER_ASSIGNED)
+		condvar_wait(&worker->state_changed, &worker->lock);
+
+	wimlib_assert(worker->state == WORKER_COMPLETE);
+	ret = worker->result;
+	if (!ret) {
+		ret = consumer(worker->uncompressed_buf,
+			       worker->job.uncompressed_size,
+			       worker->job.uncompressed_offset,
+			       consumer_ctx);
+	}
+	worker->state = WORKER_IDLE;
+	condvar_broadcast(&worker->state_changed);
+	mutex_unlock(&worker->lock);
+	return ret;
+}
+
+static void
+destroy_workers(struct decompressor_worker *workers, unsigned num_workers)
+{
+	if (!workers)
+		return;
+
+	for (unsigned i = 0; i < num_workers; i++) {
+		struct decompressor_worker *worker = &workers[i];
+
+		if (worker->thread_started)
+			terminate_worker(worker);
+	}
+	for (unsigned i = 0; i < num_workers; i++) {
+		struct decompressor_worker *worker = &workers[i];
+
+		if (worker->thread_started)
+			thread_join(&worker->thread);
+		if (worker->in_fd_open)
+			filedes_close(&worker->in_fd);
+		wimlib_free_decompressor(worker->decompressor);
+		FREE(worker->compressed_buf);
+		FREE(worker->uncompressed_buf);
+		if (worker->condvar_initialized)
+			condvar_destroy(&worker->state_changed);
+		if (worker->lock_initialized)
+			mutex_destroy(&worker->lock);
+	}
+	FREE(workers);
+}
+
+static unsigned
+limit_worker_count(unsigned requested, size_t num_jobs, u32 chunk_size,
+		   u32 max_compressed_size, u64 max_memory)
+{
+	u64 bytes_per_worker;
+	unsigned num_workers;
+
+	if (requested == 0)
+		requested = get_available_cpus();
+	num_workers = requested;
+	if ((size_t)num_workers > num_jobs)
+		num_workers = num_jobs;
+	if (num_workers < 2)
+		return num_workers;
+
+	if (max_memory == 0) {
+		/*
+		 * Leave most memory to WinPE, the filesystem cache, and the caller.
+		 * The absolute cap prevents large solid chunks from consuming all
+		 * otherwise available RAM on high-core-count machines.
+		 */
+		max_memory = min(get_available_memory() / 4,
+				 (u64)2 * 1024 * 1024 * 1024);
+	}
+
+	bytes_per_worker = (u64)chunk_size + max_compressed_size;
+	if (bytes_per_worker == 0)
+		return 1;
+	while (num_workers > 1 &&
+	       (u64)num_workers * bytes_per_worker > max_memory)
+		num_workers--;
+	return num_workers;
+}
+
+int
+decompress_jobs_parallel(const tchar *filename,
+			 const struct parallel_decompression_job *jobs,
+			 size_t num_jobs, int ctype, u32 chunk_size,
+			 unsigned num_threads, u64 max_memory,
+			 bool recover_data,
+			 parallel_decompression_consumer_t consumer,
+			 void *consumer_ctx)
+{
+	struct decompressor_worker *workers = NULL;
+	u32 max_compressed_size = 0;
+	unsigned num_workers;
+	size_t next_job;
+	int ret = WIMLIB_ERR_NOMEM;
+
+	if (num_jobs < 2 || num_threads == 1)
+		return -1;
+
+	for (size_t i = 0; i < num_jobs; i++)
+		max_compressed_size = max(max_compressed_size,
+					  jobs[i].compressed_size);
+
+	num_workers = limit_worker_count(num_threads, num_jobs, chunk_size,
+					 max_compressed_size, max_memory);
+	if (num_workers < 2)
+		return -1;
+
+	workers = CALLOC(num_workers, sizeof(workers[0]));
+	if (!workers)
+		goto out;
+
+	for (unsigned i = 0; i < num_workers; i++) {
+		struct decompressor_worker *worker = &workers[i];
+
+		ret = open_parallel_read_filedes(filename, &worker->in_fd);
+		if (ret)
+			goto out;
+		worker->in_fd_open = true;
+		if (!mutex_init(&worker->lock))
+			goto out;
+		worker->lock_initialized = true;
+		if (!condvar_init(&worker->state_changed))
+			goto out;
+		worker->condvar_initialized = true;
+		worker->recover_data = recover_data;
+		worker->compressed_buf = MALLOC(max_compressed_size);
+		worker->uncompressed_buf = MALLOC(chunk_size);
+		if (!worker->compressed_buf || !worker->uncompressed_buf)
+			goto out;
+		ret = wimlib_create_decompressor(ctype, chunk_size,
+						 &worker->decompressor);
+		if (ret)
+			goto out;
+	}
+
+	for (unsigned i = 0; i < num_workers; i++) {
+		if (!thread_create(&workers[i].thread,
+				   decompressor_worker_proc, &workers[i])) {
+			ret = WIMLIB_ERR_NOMEM;
+			goto out;
+		}
+		workers[i].thread_started = true;
+	}
+
+	for (next_job = 0; next_job < num_workers; next_job++) {
+		ret = assign_job(&workers[next_job], &jobs[next_job]);
+		if (ret)
+			goto out;
+	}
+
+	for (size_t completed = 0; completed < num_jobs; completed++) {
+		struct decompressor_worker *worker =
+			&workers[completed % num_workers];
+
+		ret = consume_worker_result(worker, consumer, consumer_ctx);
+		if (ret)
+			goto out;
+
+		if (next_job < num_jobs) {
+			ret = assign_job(worker, &jobs[next_job++]);
+			if (ret)
+				goto out;
+		}
+	}
+	ret = 0;
+
+out:
+	if (ret == WIMLIB_ERR_DECOMPRESSION)
+		ERROR("Failed to decompress data in parallel worker!");
+	else if (ret == WIMLIB_ERR_READ)
+		ERROR_WITH_ERRNO("Error reading data from WIM file");
+	else if (ret == WIMLIB_ERR_OPEN)
+		ERROR_WITH_ERRNO("Error opening WIM file for parallel reading");
+	destroy_workers(workers, workers ? num_workers : 0);
+	return ret;
+}
