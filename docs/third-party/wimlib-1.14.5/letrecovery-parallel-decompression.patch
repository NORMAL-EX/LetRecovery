-/* Use the Win32 API to get the number of processors.  */
+typedef WORD (WINAPI *get_active_processor_group_count_t)(void);
+typedef DWORD (WINAPI *get_active_processor_count_t)(WORD);
+typedef BOOL (WINAPI *get_process_group_affinity_t)(HANDLE, PUSHORT, PUSHORT);
+
+#ifndef ALL_PROCESSOR_GROUPS
+#  define ALL_PROCESSOR_GROUPS ((WORD)0xffff)
+#endif
+
+static unsigned
+count_set_affinity_bits(DWORD_PTR mask)
+{
+	unsigned count = 0;
+
+	while (mask) {
+		count += mask & 1;
+		mask >>= 1;
+	}
+	return count;
+}
